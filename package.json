{
  "name": "weare",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @weare/web",
    "build": "npm run build -w @weare/web",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify:db": "node supabase/tests/verify.mjs",
    "test:flow": "esbuild packages/core/src/index.ts --bundle --format=esm --platform=node --outfile=supabase/tests/.core.mjs --log-level=error && node supabase/tests/walkthrough.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"packages/core/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
