# Copy to .env and fill in. .env itself is gitignored.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Patient/association model (patients post requests, associations verify them).
#
# Leave unset or "false" to run the legacy hospital-account flow. Only set this
# to "true" against a database that has the 20260817* migrations applied — the
# request queries select columns that do not exist before then, and PostgREST
# rejects the whole query if they are missing.
#
# Anything other than the exact string "true" counts as off, so a typo falls
# back to the legacy flow rather than half-enabling a migration in progress.
VITE_PATIENT_MODEL=false

# Phone verification without SMS. When "true", the OTP step accepts one fixed
# code (000000) and sends nothing — the only way to complete the request flow
# on a project with no Twilio configured, which is every environment below
# production. Anything other than the exact string "true" leaves the real
# Supabase phone provider in place.
#
# NEVER set this in production: it would let anyone claim any phone number.
VITE_DEMO_OTP=true
