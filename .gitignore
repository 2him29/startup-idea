node_modules/
dist/
dist-ssr/
.env
.env.local
*.local
.DS_Store
Thumbs.db
.claude/

# Design handoff bundles dropped into the repo for reference -- not app code.
/Health Service Mobile App/

# Editor settings stay local
.vscode/

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Throwaway Postgres cluster created by npm run verify:db
/supabase/tests/.pgdata/

# Core bundle generated by npm run test:flow
/supabase/tests/.core.mjs

# Database dumps. `supabase db dump` writes into the working directory by
# default, and a data dump contains real emails, phone numbers and blood
# types — this repo is public. Narrow patterns on purpose: supabase/migrations
# and supabase/seed.sql are legitimate .sql files that must stay tracked.
/live-*.sql
/backup*.sql
/*-dump.sql
/dump*.sql

# Claude Design exports, dropped in the root to be read and then finished with.
# They are large (several MB of screenshots) and the implemented result is the
# thing worth versioning, not the archive it came from.
/*.dc.html
/Qatra*.zip
/Design*.zip

# LaTeX build leftovers. The compiled dossier PDF is tracked; the aux files
# that produce it are not.
docs/build/*.aux
docs/build/*.log
docs/build/*.out
docs/build/*.toc
